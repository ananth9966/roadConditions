rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Prerequisite: enable Anonymous sign-in in the Firebase console under
// Authentication > Sign-in method. Without it request.auth stays null and
// every create below is rejected.

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules functions must be declared inside the match scope that uses them.
    function isKnownCondition(c) {
      return c in [
        'closedBlocked', 'noTravelAdvised',
        'iceCompactedSnow', 'scatteredIce',
        'snowCovered', 'scatteredSnowDrifts',
        'frost', 'scatteredFrost',
        'wetSlush', 'scatteredWetSlush',
        'seasonalGood'
      ];
    }

    // Rolette County bounding box — the area the road data covers. A report
    // outside it cannot have been snapped to our network.
    function isInCounty(lat, lon) {
      return lat is number && lat > 48.5 && lat < 49.05
          && lon is number && lon > -100.15 && lon < -99.3;
    }

    function isWellFormedReport(d) {
      return d.keys().hasOnly([
               'condition', 'lat', 'lon', 'accuracyM',
               'segmentId', 'roadName', 'snapDistanceM', 'createdAt'
             ])
          && d.keys().hasAll([
               'condition', 'lat', 'lon', 'accuracyM',
               'segmentId', 'snapDistanceM', 'createdAt'
             ])

          && d.condition is string
          && isKnownCondition(d.condition)

          && isInCounty(d.lat, d.lon)

          && d.accuracyM is number && d.accuracyM >= 0 && d.accuracyM <= 100

          // Server-side echo of the client's snap check: a report claiming to
          // sit more than 60 m from a road was not snapped by our client.
          && d.snapDistanceM is number
          && d.snapDistanceM >= 0 && d.snapDistanceM <= 60

          && d.segmentId is string && d.segmentId.size() <= 40
          && (!('roadName' in d) || (d.roadName is string && d.roadName.size() <= 80))

          // Must be the server's clock, not one the client invented.
          && d.createdAt == request.time;
    }

    match /reports/{reportId} {

      // The map is public, so reads stay open.
      allow read: if true;

      allow create: if request.auth != null
                    && isWellFormedReport(request.resource.data);

      // Append-only: no client may rewrite or erase a report. Moderation runs
      // through the Firebase console or Admin SDK, which bypass these rules.
      allow update, delete: if false;
    }

    // Passive "this road was slow" signals. Deliberately a separate
    // collection from reports: a human saying the road is icy and a phone
    // noticing slow travel are different kinds of claim and must not be
    // rendered or trusted as the same thing.
    match /traffic/{signalId} {
      allow read: if true;
      allow update, delete: if false;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'segmentId', 'roadName', 'lat', 'lon',
                         'speedBucketMps', 'createdAt'
                       ])
                    && request.resource.data.keys().hasAll([
                         'segmentId', 'lat', 'lon', 'speedBucketMps', 'createdAt'
                       ])
                    && request.resource.data.segmentId is string
                    && request.resource.data.segmentId.size() <= 40
                    && isInCounty(request.resource.data.lat, request.resource.data.lon)
                    && request.resource.data.speedBucketMps is int
                    && request.resource.data.speedBucketMps >= 0
                    && request.resource.data.speedBucketMps <= 40
                    && (!('roadName' in request.resource.data)
                        || (request.resource.data.roadName is string
                            && request.resource.data.roadName.size() <= 80))
                    && request.resource.data.createdAt == request.time;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
